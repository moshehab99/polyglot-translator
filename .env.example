# Copy this file to .env and fill in the key for the provider you use.
# .env is git-ignored. Never commit real keys.

# Which translation provider to use: gemini | anthropic
PROVIDER=gemini

# --- Gemini (default; free tier via Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (alternative; https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Limits
MAX_CHARS=5000
REQUEST_TIMEOUT_S=60
