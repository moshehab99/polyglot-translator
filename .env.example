# Copy this file to .env and fill in the key for the provider you use.
# .env is git-ignored. Never commit real keys.
# Only the key for the active PROVIDER is required; the server refuses to start without it.
# Restart the server after editing .env.

# Which translation provider to use: gemini | anthropic
PROVIDER=gemini

# --- Gemini (default). Free key from Google AI Studio: https://aistudio.google.com/apikey
# Free tier: rate limited, and Google may use your prompts and responses to improve
# its products. Do not send confidential text on a free-tier key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (alternative, paid). Key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Limits
# Maximum characters per translation request (1-50000).
MAX_CHARS=5000
# Timeout for one provider call, in seconds.
REQUEST_TIMEOUT_S=60
